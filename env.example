POSTGRES_DB=loco_app
POSTGRES_USER=loco
POSTGRES_PASSWORD=loco
DATABASE_URL=postgres://loco:loco@db:5432/loco_app
REDIS_URL=redis://redis:6379
MAILER_HOST=mailer
# Set these in production (do not rely on the committed fallback values)
JWT_SECRET=
REFRESH_SECRET=
# Firebase custom tokens for chat (POST /api/auth/firebase-token).
# Either the service-account JSON itself or a path to it. Leave empty to
# disable (endpoint returns 503). Never commit the key file.
FIREBASE_SERVICE_ACCOUNT_PATH=
